      "name": "home-assistant",
      "description": "Control smart home devices via Home Assistant API",
      "version": "1.0.0",
      "author": "VyomKulshrestha",
      "url": "https://github.com/VyomKulshrestha/Heliox-OS/tree/main/plugins/home-assistant",
