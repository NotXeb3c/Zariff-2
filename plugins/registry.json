        {
          "name": "ha_lights",
          "description": "List all lights in Home Assistant",
          "inputs": [],
          "outputs": [
            "lights"
          ],
          "permission_tier": 2,
          "action_type": "api_call"
        },
        {
          "name": "ha_set_light",
          "description": "Turn a light on or off",
          "inputs": [
            "entity_id",
            "state"
          ],
          "outputs": [
            "result"
          ],
          "permission_tier": 2,
          "action_type": "api_call"
        }
      ],
      "capabilities": {
        "filesystem": {
          "read": [],
          "write": []
        },
        "network_domains": [
          "homeassistant.local"
        ],
        "processes": [],
        "credentials": [
          "HA_URL",
          "HA_TOKEN"
        ],
        "clipboard": {
          "read": false,
          "write": false
        },
        "media": {
          "camera": false,
          "microphone": false
        },
        "data_retention": {
          "mode": "none",
          "max_days": 0
        },
        "destructive_actions": true
