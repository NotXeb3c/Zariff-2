{
  "name": "weather",
  "version": "1.0.0",
  "description": "Get live current weather and forecasts from wttr.in",
  "author": "community",
  "tools": [
    {
      "name": "get_weather",
      "description": "Get current weather for a city",
      "inputs": ["city"],
      "outputs": ["temperature", "condition", "humidity"],
      "permission_tier": 1,
      "action_type": "api_call"
    },
    {
      "name": "get_forecast",
      "description": "Get 5-day weather forecast",
      "inputs": ["city"],
      "outputs": ["forecast"],
      "permission_tier": 1,
      "action_type": "api_call"
    }
  ],
  "agent_type": "system",
  "entry_point": "plugin.py",
  "runtime_type": "python",
  "dependencies": [],
  "capabilities": {
    "filesystem": {"read": [], "write": []},
    "network_domains": ["wttr.in"],
    "processes": [],
    "credentials": [],
    "clipboard": {"read": false, "write": false},
    "media": {"camera": false, "microphone": false},
    "data_retention": {"mode": "none", "max_days": 0},
    "destructive_actions": false
  }
}
